// March7th Bloom (Light) — Misskey theme · v2 低饱和
// 调色板：
//   #EDD9E1 雾玫瑰  bg / deckBg        （S=36%，页面底退为淡雾玫瑰灰）
//   #FBF4F7 月白粉  panel / navBg / pageHeaderBg（S=47% 但明度 97%，近白仅带粉调）
//   #F3E4EA 浅米粉  panelHeaderBg / panelHighlight / buttonBg（中档，卡片与其头部分层）
//   #FEF9FC 近白    popup / fgOnAccent
//   #DB9CB0 亮玫瑰  navIndicator / love / buttonHoverBg（仅图标/指示器/悬停，不作文字色）
//   #8E677F 藕荷    accent / fgOnWhite（比 v1 的 #A17892 深一档：按钮白字 4.59:1 过 AA）
//   #B3AAC9 雾紫    infoBg
//   #4C365E 深紫    fg / infoFg / buttonGradateB
// v2 变更：v1 大面积高饱和粉底（panel S=67%）反馈扎眼，panel/bg 全面降饱和提明度，
// 粉色只保留在强调位（指示器/爱心/悬停）；accent 加深修复 fgOnAccent 3.59:1。
// 彩色文字（链接/提及/话题标签/导航选中）统一取 accent 加深一档，粉底/粉面上均 ≥5:1。
{
	id: 'ab19e5e6-dcdc-4145-9e41-cb7dea450971',

	name: 'March7th Bloom',
	author: 'HarukiTakehata',
	desc: 'v2 · 低饱和版：粉面板降饱和提明度，修复按钮白字对比度｜Palette: #EDD9E1 #FBF4F7 #F3E4EA #DB9CB0 #8E677F #B3AAC9 #4C365E',

	base: 'light',

	props: {
		accent: '#8E677F',
		accentedBg: ':alpha<0.2<@accent',
		love: '#DB9CB0',
		focus: ':alpha<0.35<@accent',

		bg: '#EDD9E1',
		fg: '#4C365E',
		fgHighlighted: ':darken<8<@accent',
		fgOnAccent: '#FEF9FC',
		fgOnWhite: ':darken<8<@accent',
		divider: 'rgba(76, 54, 94, 0.14)',

		panel: '#FBF4F7',
		panelHighlight: '#F3E4EA',
		panelHeaderBg: '#F3E4EA',
		popup: '#FEF9FC',
		shadow: 'rgba(76, 54, 94, 0.14)',
		header: ':alpha<0.8<@panel',

		navBg: '@panel',
		navActive: ':darken<8<@accent',
		navIndicator: '#DB9CB0',
		pageHeaderBg: '@panel',

		link: ':darken<8<@accent',
		hashtag: ':darken<8<@accent',
		mention: ':darken<8<@accent',
		mentionMe: ':darken<8<@accent',
		renote: ':darken<8<@accent',

		buttonBg: '#F3E4EA',
		buttonHoverBg: '#DB9CB0',
		buttonGradateA: '@accent',
		buttonGradateB: '#4C365E',

		switchBg: 'rgba(76, 54, 94, 0.2)',
		switchOffBg: 'rgba(76, 54, 94, 0.14)',
		inputBorder: 'rgba(76, 54, 94, 0.18)',
		inputBorderHover: 'rgba(76, 54, 94, 0.32)',
		folderHeaderBg: 'rgba(76, 54, 94, 0.06)',
		folderHeaderHoverBg: 'rgba(76, 54, 94, 0.12)',

		infoBg: '#B3AAC9',
		infoFg: '#4C365E',

		deckBg: ':darken<6<@bg',
		htmlThemeColor: '@bg',
	},

	codeHighlighter: {
		base: 'catppuccin-latte',
	},
}
